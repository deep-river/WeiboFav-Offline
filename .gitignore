# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment
.env*

# deployment and generated files
.vercel
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# Local library content and browser session (never commit)
/data/*
!/data/.gitignore
/capture.config.json
/.weibofav-server.pid
/.weibofav-server.port
/.weibofav-api.pid
/.weibofav-api.port
/__pycache__/

# The starter ships a broad UI catalog; track only the primitives used here.
/components/ui/*
!/components/ui/alert-dialog.tsx
!/components/ui/badge.tsx
!/components/ui/button.tsx
!/components/ui/checkbox.tsx
!/components/ui/dialog.tsx
!/components/ui/pagination.tsx

# Unused starter hook catalog.
/hooks/
